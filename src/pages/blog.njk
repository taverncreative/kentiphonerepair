---
layout: layouts/base.njk
title: iPhone Repair Blog
seoTitle: iPhone Repair Blog | Tips, Advice & News | Kent iPhone Repair
seoDescription: "Read the latest iPhone repair tips, advice, and industry insights from Kent iPhone Repair. Expert guides on screen repairs, battery care, and more."
permalink: /blog/
---

{# ── Blog Hero ── #}
<section class="blog-hero" aria-labelledby="blog-hero-heading">
  <div class="blog-hero__container">
    <h1 class="blog-hero__heading" id="blog-hero-heading">iPhone Repair Blog</h1>
    <p class="blog-hero__text">Tips, advice, and insights from Kent's most trusted mobile iPhone repair service. Whether you're looking after your battery, dealing with a cracked screen, or choosing a repair service - we've got you covered.</p>
  </div>
</section>

{# ── Category Filter ── #}
<section class="blog-categories" aria-label="Blog categories">
  <div class="blog-categories__container">
    <nav class="blog-categories__nav">
      <a href="/blog/" class="blog-categories__link blog-categories__link--active" aria-current="page">All Posts</a>
      {% for category in blogCategories %}
      <a href="/blog/categories/{{ category.slug }}/" class="blog-categories__link">{{ category.name }}</a>
      {% endfor %}
    </nav>
  </div>
</section>

{# ── Blog Post Grid ── #}
<section class="blog-grid" aria-labelledby="blog-grid-heading">
  <div class="blog-grid__container">
    <h2 class="visually-hidden" id="blog-grid-heading">All Blog Posts</h2>

    {% set blogPosts = collections.blogPosts %}
    {% if blogPosts and blogPosts.length %}
    <div class="blog-grid__grid">
      {% for post in blogPosts | reverse %}
      <article class="blog-card">
        {% if post.data.image %}
        <div class="blog-card__image-wrapper">
          <a href="{{ post.url }}">
            <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" class="blog-card__image" width="400" height="250" loading="lazy">
          </a>
        </div>
        {% endif %}
        <div class="blog-card__content">
          {% if post.data.category %}
          <span class="blog-card__category">{{ post.data.category }}</span>
          {% endif %}
          <h3 class="blog-card__title">
            <a href="{{ post.url }}" class="blog-card__link">{{ post.data.title }}</a>
          </h3>
          {% if post.data.excerpt %}
          <p class="blog-card__excerpt">{{ post.data.excerpt }}</p>
          {% endif %}
          <time class="blog-card__date" datetime="{{ post.date | dateISO }}">{{ post.date | dateDisplay }}</time>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="blog-grid__empty">No blog posts yet. Check back soon for tips, advice, and repair insights.</p>
    {% endif %}

  </div>
</section>

{# ── CTA Banner ── #}
{% set ctaHeading = "Need an iPhone Repair?" %}
{% set ctaText = "Don't wait around - get in touch today for a fast, free quote. We come to you anywhere in Kent and most repairs are done in under 30 minutes." %}
{% include "partials/cta-banner.njk" %}
