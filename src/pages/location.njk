---
layout: layouts/base.njk
pagination:
  addAllPagesToCollections: true
  data: locations
  size: 1
  alias: location
permalink: "/{{ location.slug }}/"
eleventyComputed:
  title: "{{ location.heroTitle }}"
  seoTitle: "{{ location.heroTitle }} | Kent iPhone Repair"
  seoDescription: "{{ location.heroDescription }}"
---

{# ── Vary section order based on location index to break template patterns ── #}
{% set locIndex = locations.indexOf(location) %}
{% set layoutVariant = locIndex % 3 %}
{% set locSlug = location.slug | replace("-iphone-repair", "") %}

{# ── Hero Section ── #}
{% set heroTitle = location.heroTitle %}
{% set heroDescription = location.heroDescription %}
{% set heroImage = location.heroImage or "/img/repair/driving.webp" %}
{% set heroImageAlt = "Mobile iPhone repair technician arriving in " + location.name + ", " + location.county %}
{% include "partials/hero.njk" %}

{# ── Breadcrumb Trail ── #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="breadcrumb__container">
    <ol class="breadcrumb__list" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1">
      </li>
      <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span itemprop="name">{{ location.name }}</span>
        <meta itemprop="position" content="2">
      </li>
    </ol>
  </div>
</nav>

{# ── Location Intro - unique content from data ── #}
{% if location.introText %}
<section class="loc-intro" aria-labelledby="location-intro-heading">
  <div class="loc-intro__container">
    <h2 class="loc-intro__heading" id="location-intro-heading">About Our {{ location.name }} Service</h2>
    <div class="loc-intro__text">{{ location.introText }}</div>
    {% if location.localAreas and location.localAreas.length %}
    <div class="loc-intro__coverage">
      <h3 class="loc-intro__coverage-title">Areas we cover around {{ location.name }}</h3>
      <ul class="loc-intro__area-tags">
        {% for area in location.localAreas %}
        <li class="loc-intro__area-tag">{{ area }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{# ── LAYOUT VARIANT A: Services → Testimonials → How It Works ── #}
{% if layoutVariant == 0 %}

  {# ── Services with unique descriptions from data ── #}
  <section class="location-services" aria-labelledby="location-services-heading">
    <div class="location-services__container">
      <h2 class="location-services__heading" id="location-services-heading">iPhone Repairs Available in {{ location.name }}</h2>
      <div class="location-services__grid">
        {% set svcData = {
          "screen-repair": {"name": "iPhone Screen Repair", "slug": "iphone-screen-repair"},
          "battery-replacement": {"name": "iPhone Battery Replacement", "slug": "iphone-battery-replacement"},
          "charging-port-repair": {"name": "Charging Port Repair", "slug": "iphone-charging-port-repair"}
        } %}
        {% for svc in location.services %}
          {% set s = svcData[svc] %}
          {% if s %}
          <article class="location-services__card">
            <h3 class="location-services__card-title">{{ s.name }}</h3>
            <p class="location-services__card-text">{{ location.serviceDescriptions[svc] if location.serviceDescriptions else "" }}</p>
            <a href="/{{ locSlug }}-{{ s.slug }}/" class="btn btn--outline">{{ s.name }} in {{ location.name }}</a>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {% set testimonialSet = location.testimonialSet or false %}
  {% include "partials/testimonials.njk" %}
  {% include "partials/how-it-works.njk" %}

{# ── LAYOUT VARIANT B: How It Works → Services → Nearby ── #}
{% elif layoutVariant == 1 %}

  {% include "partials/how-it-works.njk" %}

  <section class="location-services" aria-labelledby="location-services-heading">
    <div class="location-services__container">
      <h2 class="location-services__heading" id="location-services-heading">What We Repair in {{ location.name }}</h2>
      <div class="location-services__grid">
        {% set svcData = {
          "screen-repair": {"name": "iPhone Screen Repair", "slug": "iphone-screen-repair"},
          "battery-replacement": {"name": "iPhone Battery Replacement", "slug": "iphone-battery-replacement"},
          "charging-port-repair": {"name": "Charging Port Repair", "slug": "iphone-charging-port-repair"}
        } %}
        {% for svc in location.services %}
          {% set s = svcData[svc] %}
          {% if s %}
          <article class="location-services__card">
            <h3 class="location-services__card-title">{{ s.name }}</h3>
            <p class="location-services__card-text">{{ location.serviceDescriptions[svc] if location.serviceDescriptions else "" }}</p>
            <a href="/{{ locSlug }}-{{ s.slug }}/" class="btn btn--outline">{{ s.name }} in {{ location.name }}</a>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {# ── Nearby first, then testimonials ── #}
  {% if location.nearbyAreas and location.nearbyAreas.length %}
  <section class="cross-links" aria-labelledby="nearby-locations-heading">
    <div class="cross-links__container">
      <h2 class="cross-links__heading" id="nearby-locations-heading">We Also Cover These Nearby Towns</h2>
      <ul class="cross-links__list">
        {% for nearby in location.nearbyAreas %}
          {% set nearbySlug = nearby | slugify %}
          <li class="cross-links__item">
            <a href="/{{ nearbySlug }}-iphone-repair/" class="cross-links__link">{{ nearby }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% set testimonialSet = location.testimonialSet or false %}
  {% include "partials/testimonials.njk" %}

{# ── LAYOUT VARIANT C: Testimonials first → Services → How it works ── #}
{% else %}

  {% set testimonialSet = location.testimonialSet or false %}
  {% include "partials/testimonials.njk" %}

  <section class="location-services" aria-labelledby="location-services-heading">
    <div class="location-services__container">
      <h2 class="location-services__heading" id="location-services-heading">Repairs We Offer in {{ location.name }}</h2>
      <div class="location-services__grid">
        {% set svcData = {
          "screen-repair": {"name": "iPhone Screen Repair", "slug": "iphone-screen-repair"},
          "battery-replacement": {"name": "iPhone Battery Replacement", "slug": "iphone-battery-replacement"},
          "charging-port-repair": {"name": "Charging Port Repair", "slug": "iphone-charging-port-repair"}
        } %}
        {% for svc in location.services %}
          {% set s = svcData[svc] %}
          {% if s %}
          <article class="location-services__card">
            <h3 class="location-services__card-title">{{ s.name }}</h3>
            <p class="location-services__card-text">{{ location.serviceDescriptions[svc] if location.serviceDescriptions else "" }}</p>
            <a href="/{{ locSlug }}-{{ s.slug }}/" class="btn btn--outline">{{ s.name }} in {{ location.name }}</a>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {% include "partials/how-it-works.njk" %}

{% endif %}

{# ── Contact Form ── #}
{% include "partials/contact-form.njk" %}

{# ── CTA Banner - varied per location ── #}
{% set ctaMessages = [
  "Ready to get your iPhone fixed in " + location.name + "? Call or text Sam directly.",
  "Based in " + location.name + "? Book your repair and we'll be with you today.",
  "Need a repair in " + location.name + "? Text us your model and postcode for an instant quote."
] %}
{% set ctaHeading = ctaMessages[layoutVariant] %}
{% set ctaText = location.ctaText or "Call 07758 115476 or fill in the form above. Same-day appointments available across " + location.name + " and surrounding areas." %}
{% include "partials/cta-banner.njk" %}

{# ── Nearby Location Links (for variants 0 and 2 that haven't shown it yet) ── #}
{% if layoutVariant != 1 %}
{% if location.nearbyAreas and location.nearbyAreas.length %}
<section class="cross-links" aria-labelledby="nearby-locations-heading">
  <div class="cross-links__container">
    <h2 class="cross-links__heading" id="nearby-locations-heading">iPhone Repair in Nearby Towns</h2>
    <ul class="cross-links__list">
      {% for nearby in location.nearbyAreas %}
        {% set nearbySlug = nearby | slugify %}
        <li class="cross-links__item">
          <a href="/{{ nearbySlug }}-iphone-repair/" class="cross-links__link">{{ nearby }}</a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% endif %}
