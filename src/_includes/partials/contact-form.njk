<section class="contact-form-section" aria-labelledby="contact-form-heading">
  <div class="contact-form-section__container">
    <div class="contact-form-section__grid">

      {# Left Column: Text #}
      <div class="contact-form-section__text">
        <h2 class="contact-form-section__heading" id="contact-form-heading">Get a Fast iPhone Repair Quote Today</h2>
        <p>Need a quick, reliable iPhone repair? Send us your details and we'll get back to you with a quote - usually within minutes.</p>
        <p>We offer a fully mobile service across Kent, so there's no need to visit a shop. Just tell us what's wrong, and we'll come to you at a time that suits.</p>
        <p>Whether it's a cracked screen, dead battery, or faulty charging port - we've got you covered with fast, affordable repairs at your doorstep.</p>
      </div>

      {# Right Column: Form #}
      <div class="contact-form-section__form-wrapper">
        <form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>

          {# Web3Forms access key - create at web3forms.com with both emails linked #}
          <input type="hidden" name="access_key" value="bd5ef20f-198b-4988-a363-23258ba24df4">
          <input type="hidden" name="subject" value="New iPhone Repair Quote Request">
          <input type="hidden" name="from_name" value="Kent iPhone Repair Website">
          {# Hidden field for page source #}
          <input type="hidden" name="_source" value="{{ page.url }}">
          {# Honeypot spam protection #}
          <input type="checkbox" name="botcheck" class="hidden" style="display:none">

          <div class="contact-form__group">
            <label for="contact-name" class="contact-form__label">Name</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              class="contact-form__input"
              required
              autocomplete="name"
              placeholder="Your full name"
            >
          </div>

          <div class="contact-form__group">
            <label for="contact-phone" class="contact-form__label">Phone Number</label>
            <input
              type="tel"
              id="contact-phone"
              name="phone"
              class="contact-form__input"
              required
              autocomplete="tel"
              placeholder="07xxx xxxxxx"
            >
          </div>

          <div class="contact-form__group">
            <label for="contact-email" class="contact-form__label">Email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              class="contact-form__input"
              required
              autocomplete="email"
              placeholder="you@example.com"
            >
          </div>

          <div class="contact-form__group">
            <label for="contact-model" class="contact-form__label">iPhone Model</label>
            <select
              id="contact-model"
              name="model"
              class="contact-form__select"
              required
            >
              <option value="">Select your iPhone model...</option>
              <option value="iphone-16-pro-max">iPhone 16 Pro Max</option>
              <option value="iphone-16-pro">iPhone 16 Pro</option>
              <option value="iphone-16-plus">iPhone 16 Plus</option>
              <option value="iphone-16">iPhone 16</option>
              <option value="iphone-15-pro-max">iPhone 15 Pro Max</option>
              <option value="iphone-15-pro">iPhone 15 Pro</option>
              <option value="iphone-15-plus">iPhone 15 Plus</option>
              <option value="iphone-15">iPhone 15</option>
              <option value="iphone-14-pro-max">iPhone 14 Pro Max</option>
              <option value="iphone-14-pro">iPhone 14 Pro</option>
              <option value="iphone-14">iPhone 14</option>
              <option value="iphone-13-pro-max">iPhone 13 Pro Max</option>
              <option value="iphone-13-pro">iPhone 13 Pro</option>
              <option value="iphone-13">iPhone 13</option>
              <option value="iphone-12-pro-max">iPhone 12 Pro Max</option>
              <option value="iphone-12-pro">iPhone 12 Pro</option>
              <option value="iphone-12">iPhone 12</option>
              <option value="iphone-11-pro-max">iPhone 11 Pro Max</option>
              <option value="iphone-11-pro">iPhone 11 Pro</option>
              <option value="iphone-11">iPhone 11</option>
              <option value="iphone-xr">iPhone XR</option>
              <option value="iphone-xs-max">iPhone XS Max</option>
              <option value="iphone-xs">iPhone XS</option>
              <option value="iphone-x">iPhone X</option>
              <option value="iphone-se">iPhone SE</option>
              <option value="other">Other / Not sure</option>
            </select>
          </div>

          <div class="contact-form__group">
            <label for="contact-postcode" class="contact-form__label">Postcode</label>
            <input
              type="text"
              id="contact-postcode"
              name="postcode"
              class="contact-form__input"
              required
              autocomplete="postal-code"
              placeholder="e.g. CT1 1AA"
            >
          </div>

          <div class="contact-form__group">
            <label for="contact-fault" class="contact-form__label">Fault</label>
            <textarea
              id="contact-fault"
              name="fault"
              class="contact-form__textarea"
              rows="4"
              required
              placeholder="Describe the issue with your iPhone..."
            ></textarea>
          </div>

          <button type="submit" class="btn btn--primary contact-form__submit">
            Get a Quote
          </button>

        </form>
      </div>

    </div>
  </div>
</section>
