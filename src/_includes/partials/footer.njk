<footer class="site-footer" role="contentinfo">
  <div class="footer__container">
    <div class="footer__grid">

      {# Column 1: Brand & Contact #}
      <div class="footer__col footer__col--brand">
        <a href="/" class="footer__logo" aria-label="{{ site.name }} - Home">
          Kent <span class="logo-highlight">iPhone</span> Repair
        </a>
        <p class="footer__tagline">Mobile iPhone Repair Service - We Come to You</p>
        <p class="footer__area">Serving Ashford, Canterbury, Maidstone, Folkestone &amp; all of Kent</p>
        <p class="footer__phone">
          <a href="{{ site.phoneLink }}" class="footer__phone-link">{{ site.phone }}</a>
        </p>
      </div>

      {# Column 2: Menu Links #}
      <div class="footer__col">
        <h3 class="footer__heading">Menu</h3>
        <ul class="footer__list">
          <li><a href="/" class="footer__link">Home</a></li>
          <li><a href="/services/" class="footer__link">Services</a></li>
          <li><a href="/iphone-repair-faqs/" class="footer__link">FAQs</a></li>
          <li><a href="/blog/" class="footer__link">Blog</a></li>
          <li><a href="/about/" class="footer__link">About</a></li>
          <li><a href="/contact/" class="footer__link">Contact</a></li>
        </ul>
      </div>

      {# Column 3: Policy Links #}
      <div class="footer__col">
        <h3 class="footer__heading">Policy</h3>
        <ul class="footer__list">
          <li><a href="/privacy-policy/" class="footer__link">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions/" class="footer__link">Terms &amp; Conditions</a></li>
          <li><a href="/cookie-policy/" class="footer__link">Cookie Policy</a></li>
        </ul>
      </div>

      {# Column 4: Social Links #}
      <div class="footer__col">
        <h3 class="footer__heading">Social</h3>
        <ul class="footer__list">
          <li>
            <a href="{{ site.social.facebook }}" class="footer__link" target="_blank" rel="noopener noreferrer">Facebook</a>
          </li>
          <li>
            <a href="{{ site.social.google }}" class="footer__link" target="_blank" rel="noopener noreferrer">Google</a>
          </li>
          <li>
            <a href="{{ site.social.google }}" class="footer__link" target="_blank" rel="noopener noreferrer">Reviews</a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  {# Bottom Bar #}
  <div class="footer__bottom">
    <div class="footer__container">
      <p class="footer__copyright">&copy;{{ site.copyright }}</p>
    </div>
  </div>
</footer>
