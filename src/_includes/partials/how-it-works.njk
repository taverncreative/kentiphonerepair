<section class="how-it-works" aria-labelledby="how-it-works-heading">
  <div class="how-it-works__container">
    <h2 class="how-it-works__heading" id="how-it-works-heading">
      {{ howItWorksHeading or "How It Works" }}
    </h2>

    <div class="how-it-works__cta-top">
      <a href="/contact/" class="btn btn--primary">Book Now</a>
    </div>

    <div class="how-it-works__grid">

      {# Step 1 #}
      <article class="how-it-works__step">
        <div class="how-it-works__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="14" y="4" width="20" height="40" rx="3" stroke="#E8734A" stroke-width="2"/>
            <line x1="20" y1="8" x2="28" y2="8" stroke="#E8734A" stroke-width="2" stroke-linecap="round"/>
            <circle cx="24" cy="38" r="2" fill="#E8734A"/>
          </svg>
        </div>
        <h3 class="how-it-works__step-title">Step 1: Send Your Details</h3>
        <p class="how-it-works__step-description">
          {{ step1Description or "Use our quick quote form or give us a call. Tell us your iPhone model, the fault, and your location in Kent - we'll get back to you with a price and available time slots." }}
        </p>
      </article>

      {# Step 2 #}
      <article class="how-it-works__step">
        <div class="how-it-works__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 4C17.373 4 12 9.373 12 16C12 26 24 44 24 44C24 44 36 26 36 16C36 9.373 30.627 4 24 4Z" stroke="#E8734A" stroke-width="2"/>
            <circle cx="24" cy="16" r="5" stroke="#E8734A" stroke-width="2"/>
          </svg>
        </div>
        <h3 class="how-it-works__step-title">Step 2: We Come to You</h3>
        <p class="how-it-works__step-description">
          {{ step2Description or "No need to travel or post your phone. We'll come to your home, office, or any convenient location across Kent at a time that suits you." }}
        </p>
      </article>

      {# Step 3 #}
      <article class="how-it-works__step">
        <div class="how-it-works__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="24" r="18" stroke="#E8734A" stroke-width="2"/>
            <path d="M16 24C16 24 20 30 24 30C28 30 32 18 32 18" stroke="#E8734A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="how-it-works__step-title">Step 3: We Fix Your Phone</h3>
        <p class="how-it-works__step-description">
          {{ step3Description or "Most repairs are completed in under 30 minutes, right in front of you. We use quality parts and offer a warranty on every repair - so you can get back to your day with peace of mind." }}
        </p>
      </article>

    </div>
  </div>
</section>
