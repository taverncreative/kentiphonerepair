---
layout: layouts/base.njk
---

<article class="blog-post">
  <div class="blog-post__container" style="max-width:var(--max-w);margin:0 auto;padding:0 24px">
    <header class="blog-post__header">
      {% if category %}
      <span class="blog-post__category">{{ category }}</span>
      {% endif %}
      <h1 class="blog-post__title" style="font-size:2.2rem;font-weight:400;margin-bottom:12px">{{ title }}</h1>
      {% if date %}
      <time class="blog-post__date" datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
      {% endif %}
    </header>

    {% if image %}
    <div class="blog-post__image">
      <img src="{{ image }}" alt="{{ imageAlt or title }}" width="800" height="500" loading="eager" style="width:100%;height:auto;object-fit:cover;aspect-ratio:16/10;border-radius:var(--radius)">
    </div>
    {% endif %}

    <div class="blog-post__content">
      {{ content | safe }}
    </div>

    <div style="padding:40px 0;border-top:1px solid var(--border-light);margin-top:40px">
      <a href="/blog/" style="color:var(--text-light);font-size:.88rem">&larr; Back to Blog</a>
    </div>
  </div>
</article>

{% include "partials/contact-form.njk" %}
{% include "partials/cta-banner.njk" %}
