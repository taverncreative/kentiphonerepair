{
  "name": "kentiphonerepair",
  "version": "1.0.0",
  "description": "Kent iPhone Repair - Fast mobile iPhone repairs across Kent",
  "scripts": {
    "build:images": "node scripts/convert-images.js",
    "build:css": "node scripts/minify-css.js",
    "build:js": "node scripts/minify-js.js",
    "build:11ty": "npx @11ty/eleventy",
    "build": "npm run build:images && npm run build:css && npm run build:js && npm run build:11ty",
    "serve": "npx @11ty/eleventy --serve",
    "dev": "npx @11ty/eleventy --serve"
  },
  "private": true,
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "cssnano": "^7.1.3",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "terser": "^5.46.1"
  }
}
